# Database
POSTGRES_USER=syspulse
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=syspulse
DATABASE_URL=postgresql+asyncpg://syspulse:change_this_strong_password@postgres:5432/syspulse

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=generate_with_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:3000

# AI
GROQ_API_KEY=get_free_at_console_groq_com

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
JAEGER_QUERY_URL=http://localhost:16686

# Push notifications (optional)
VAPID_PUBLIC_KEY=generate_with_pywebpush
VAPID_PRIVATE_KEY=generate_with_pywebpush

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_VAPID_KEY=same_as_VAPID_PUBLIC_KEY

# Agent runtime
SYSPULSE_SERVER=http://localhost:8000
AGENT_TOKEN=issued_by_agents_register
SYSPULSE_CERT_DIR=.syspulse/certs
INTERVAL=5
BATCH_SIZE=6

# Domain (production only)
DOMAIN=yourdomain.com

# Debug
DEBUG=false
