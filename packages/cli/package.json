    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "minimist": "1.2.8",
    "node-windows": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@types/minimist": "1.2.5",
    "@types/node": "22.13.10",
    "tsup": "8.4.0",
    "typescript": "5.8.2"
  }
}
