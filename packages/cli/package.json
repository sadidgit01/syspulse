{
  "name": "syspulse-agent",
  "version": "0.1.0",
  "private": false,
  "description": "SysPulse machine installer and status CLI",
  "bin": {
    "syspulse-agent": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
